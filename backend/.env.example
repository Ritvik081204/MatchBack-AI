# Everything is optional - the app runs with no configuration.
# DATABASE_URL=sqlite:///./matchback.db        # or postgresql+psycopg://user:pass@host/db
# CORS_ORIGINS=http://localhost:5173           # comma-separated; add your deployed frontend URL

# Local LLM (Ollama). If unreachable, the rule-based writer is used automatically.
LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=90

# Frontend (frontend/.env): only needed when the API is hosted on a different origin
# VITE_API_URL=https://your-backend.example.com
